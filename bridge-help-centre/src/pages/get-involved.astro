---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Media from "../components/Media.astro";
import Icon from "../components/Icon.astro";
import FormShell from "../components/FormShell.astro";
import FormField from "../components/FormField.astro";
import CtaBand from "../components/CtaBand.astro";
import { site, whatsappLink } from "../config/site.js";

const ways = [
  {
    id: "volunteer", icon: "volunteer", title: "Volunteer", button: "Volunteer With Us",
    message: "Hello, I would like to volunteer with The Bridge Help Centre",
    text: "Give your time at school outreaches, community programmes and events. Whether you can help once a term or every month, there is a place for you — and a young person who will remember you were there.",
  },
  {
    id: "partner", icon: "partner", title: "Partner", button: "Partner With Us",
    message: "Hello, I would like to partner with The Bridge Help Centre",
    text: "For schools, organisations, companies and government agencies that want to run programmes together. We bring the expertise and care; together we reach more children and young people.",
  },
  {
    id: "mentor", icon: "compass", title: "Mentor", button: "Become a Mentor",
    message: "Hello, I would like to become a mentor with The Bridge Help Centre",
    text: "For professionals willing to guide a young person through goal setting, confidence building and life skills. A few hours of your experience can change the direction of a life.",
  },
  {
    id: "support", icon: "gift", title: "Support", button: "Support Our Work",
    message: "Hello, I would like to support the work of The Bridge Help Centre",
    text: "Donate, sponsor a programme or provide materials. Every naira and every notebook helps a child learn, heal and grow.",
  },
];
---
<Base
  title="Get Involved"
  description="Volunteer, partner, mentor or support The Bridge Help Centre and help children and young people in Nigeria thrive."
>
  <PageHero title="Get Involved" subtitle="Every young person deserves someone walking beside them. Here is how you can be that someone." />

  <section class="section" aria-labelledby="ways-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Four ways to help" title="Choose how you'd like to walk with us" id="ways-heading" />
      <ul class="grid gap-6 md:grid-cols-2 lg:gap-8">
        {ways.map((w) => (
          <li id={w.id} class="card card-hover reveal flex flex-col scroll-mt-28">
            <span class="icon-badge"><Icon name={w.icon} size={28} /></span>
            <h3 class="mt-6 text-[1.75rem] font-bold">{w.title}</h3>
            <p class="mt-3 text-ink-soft">{w.text}</p>
            {w.id === "support" && site.supportDetails && (
              <div class="mt-6 rounded-2xl bg-blue-tint p-5">
                <p class="font-bold">Bank details</p>
                <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-[0.9375rem]">
                  {Object.entries(site.supportDetails).map(([k, v]) => (<><dt class="font-semibold capitalize">{k.replace(/([A-Z])/g, " $1")}</dt><dd>{String(v)}</dd></>))}
                </dl>
              </div>
            )}
            <div class="mt-auto pt-8">
              <a href={whatsappLink(w.message)} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="whatsapp" />{w.button}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="why-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <Media alt="A mentor and a young person talking together" label="Why it matters photo" size="1200 × 900 px" hint="A volunteer or mentor alongside a young person." ratio="4 / 3" />
      </div>
      <div class="reveal">
        <p class="eyebrow">Why it matters</p>
        <h2 id="why-heading" class="h-section">No young person should walk alone</h2>
        <blockquote class="mt-6 border-l-4 border-magenta pl-6 text-xl font-medium leading-relaxed lg:text-2xl">
          <p>Our goal is to ensure no young person has to navigate academic, emotional and social challenges alone. We meet you exactly where you are, and walk with you to where you want to be.</p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="form-heading" id="interest-form">
    <div class="container-site grid gap-12 lg:grid-cols-[5fr_7fr] lg:gap-20">
      <div>
        <p class="eyebrow">Say hello</p>
        <h2 id="form-heading" class="h-section">Tell us how you would like to help</h2>
        <p class="mt-5 text-ink-soft">Fill in the form and we will get back to you. Prefer to talk? <a href={whatsappLink()} target="_blank" rel="noopener" class="link">Chat with us on WhatsApp</a>.</p>
      </div>
      <div class="card">
        <FormShell id="involve-form" endpoint={site.forms.getInvolvedEndpoint} subject="New Get Involved interest — website" submitLabel="Send My Interest" successTitle="Thank you for wanting to help!" successText="We have received your interest and will be in touch soon.">
          <FormField formId="involve" name="name" label="Full name" required autocomplete="name" />
          <div class="grid gap-6 sm:grid-cols-2">
            <FormField formId="involve" name="email" label="Email" type="email" required autocomplete="email" />
            <FormField formId="involve" name="phone" label="Phone number" type="tel" autocomplete="tel" />
          </div>
          <FormField formId="involve" name="interest" label="I would like to" required options={["Volunteer", "Partner", "Mentor", "Support"]} />
          <FormField formId="involve" name="message" label="Message" type="textarea" />
        </FormShell>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
