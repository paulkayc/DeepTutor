---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { srcsetFor } from "../lib/images.js";
import { site, whatsappLink } from "../config/site.js";

/* Kept deliberately short — the owner asked for a clean page with little text. */
const ways = [
  { id: "volunteer", icon: "volunteer", title: "Volunteer", text: "Give your time at outreaches and events.", button: "Volunteer", message: "Hello, I would like to volunteer with The Bridge Help Centre" },
  { id: "partner", icon: "partner", title: "Partner", text: "Run programmes with us.", button: "Partner", message: "Hello, I would like to partner with The Bridge Help Centre" },
  { id: "mentor", icon: "compass", title: "Mentor", text: "Guide a young person.", button: "Mentor", message: "Hello, I would like to become a mentor with The Bridge Help Centre" },
  { id: "support", icon: "gift", title: "Support", text: "Donate or sponsor a programme.", button: "Support", message: "Hello, I would like to support the work of The Bridge Help Centre" },
];
const bank = site.supportDetails;
---
<Base
  title="Get Involved"
  description="Volunteer, partner, mentor or support The Bridge Help Centre and help children and young people in Nigeria thrive."
>
  <PageHero title="Get Involved">
    <a slot="aside" href="/images/events/call-for-volunteers.webp" target="_blank" rel="noopener" class="mx-auto block max-w-md overflow-hidden rounded-3xl shadow-[var(--shadow-lift)] transition hover:-translate-y-1 lg:max-w-none" title="Open full size">
      <img
        src="/images/events/call-for-volunteers.webp"
        srcset={srcsetFor("/images/events/call-for-volunteers.webp")}
        sizes="(min-width: 1024px) 40vw, (min-width: 448px) 28rem, 100vw"
        alt="Call for volunteers flyer from The Bridge Help Centre: scan the QR code, visit bit.ly/MWMFMF26, or text 'I volunteer' to 09026433052."
        width="1080"
        height="1080"
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full"
      />
    </a>
  </PageHero>

  <section class="section" aria-labelledby="ways-heading">
    <div class="container-site">
      <h2 id="ways-heading" class="h-section mb-10 lg:mb-14">How you can help</h2>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ways.map((w) => (
          <li id={w.id} class="card card-hover reveal flex scroll-mt-28 flex-col !p-7">
            <span class="icon-badge"><Icon name={w.icon} size={28} /></span>
            <h3 class="mt-5 text-2xl font-bold">{w.title}</h3>
            <p class="mt-2 text-ink-soft">{w.text}</p>
            <div class="mt-auto pt-6">
              <a href={w.id === "support" && bank ? "#give" : whatsappLink(w.message)} target={w.id === "support" && bank ? undefined : "_blank"} rel="noopener" class="btn btn-primary btn-sm w-full">
                {w.id === "support" && bank ? <>See bank details</> : <><Icon name="whatsapp" size={20} />{w.button}<span class="sr-only"> on WhatsApp</span></>}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {bank && (
    <section id="give" class="section section-tint scroll-mt-24" aria-labelledby="give-heading">
      <div class="container-site">
        <div class="card reveal mx-auto max-w-xl text-center">
          <span class="icon-badge mx-auto"><Icon name="gift" size={28} /></span>
          <h2 id="give-heading" class="h-section mt-5 !text-3xl">Support our work</h2>
          <dl class="mt-8 grid gap-5">
            <div>
              <dt class="text-sm font-bold uppercase tracking-wider text-ink-soft">Account number</dt>
              <dd class="mt-1 flex flex-wrap items-center justify-center gap-3">
                <span class="text-4xl font-extrabold tracking-[0.06em] tabular-nums" data-copy-source>{bank.accountNumber}</span>
                <button type="button" class="js-only inline-flex min-h-11 items-center gap-2 rounded-full border-2 border-blue bg-white px-4 text-sm font-bold" data-copy={bank.accountNumber}>
                  <span data-copy-label>Copy</span><span class="sr-only"> account number</span>
                </button>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-bold uppercase tracking-wider text-ink-soft">Account name</dt>
              <dd class="mt-1 text-lg font-semibold">{bank.accountName}</dd>
            </div>
            <div>
              <dt class="text-sm font-bold uppercase tracking-wider text-ink-soft">Bank</dt>
              <dd class="mt-1 text-lg font-semibold">{bank.bank}</dd>
            </div>
          </dl>
          <p class="mt-8 text-ink-soft">Thank you. Every gift helps a young person.</p>
        </div>
      </div>
    </section>
  )}

  <!-- Interest form: the centre's Google Form (set in src/config/site.js).
       It loads from Google only when the visitor taps "Show the form". -->
  <section class="section" aria-labelledby="form-heading" id="interest-form">
    <div class="container-site mx-auto max-w-3xl">
      <h2 id="form-heading" class="h-section mb-8 text-center">Tell us how you'd like to help</h2>
      <div class="card overflow-hidden !p-0">
        <div class="relative" data-gform={site.getInvolvedFormEmbed || site.getInvolvedForm}>
          <div class="flex flex-col items-center gap-4 px-6 py-12 text-center sm:px-10" data-gform-placeholder>
            <span class="icon-badge"><Icon name="file" size={28} /></span>
            <p class="max-w-md text-lg">Fill in our short form and our team will get back to you.</p>
            <div class="flex w-full flex-col items-center justify-center gap-3 sm:flex-row">
              <button type="button" class="js-only btn btn-primary w-full sm:w-auto" data-gform-load>Show the form here</button>
              <a href={site.getInvolvedForm} target="_blank" rel="noopener" class="btn btn-secondary w-full sm:w-auto">Open the form<Icon name="arrow" size={20} /><span class="sr-only"> (opens Google Forms in a new tab)</span></a>
            </div>
            <p class="max-w-md text-sm text-ink-soft">The form is provided by Google, which may set cookies when it loads. <a href={site.privacyPolicyUrl} class="link">Privacy Policy</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
