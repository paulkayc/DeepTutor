---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import QuoteBand from "../components/QuoteBand.astro";
import Stats from "../components/Stats.astro";
import DirectorBlock from "../components/DirectorBlock.astro";
import EventCard from "../components/EventCard.astro";
import EventSlideshow from "../components/EventSlideshow.astro";
import Gallery from "../components/Gallery.astro";
import CtaBand from "../components/CtaBand.astro";
import { home } from "../data/home.js";
import { services, servicesIntro } from "../data/services.js";
import { events } from "../data/events.js";

const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
// The next programme that has slideshow images is featured; otherwise show the next three as cards.
const featured = events.filter((e) => e.date >= today && e.slides?.length).sort((a, b) => a.date.localeCompare(b.date))[0];
---
<Base
  preloadImage={{ src: home.heroImage, srcset: home.heroImageSmall ? `${home.heroImageSmall} 640w, ${home.heroImage} ${home.heroImageWidth}w` : undefined }}
  title="The Bridge Help Centre"
  description="The Bridge Help Centre is a social enterprise for child and youth development in Nigeria — counselling, mentorship, learning support and school programmes for children and young people."
>
  <!-- 1. Hero: full-width photo band at the very top, headline below it -->
  <section class="relative isolate overflow-hidden bg-blue-tint" aria-labelledby="hero-heading">
    {home.heroImage ? (
      <div class="relative aspect-[2/1] w-full sm:aspect-auto sm:h-[clamp(16rem,40vw,36rem)]">
        <img
          src={home.heroImage}
          srcset={home.heroImageSmall ? `${home.heroImageSmall} 640w, ${home.heroImage} ${home.heroImageWidth}w` : undefined}
          sizes="100vw"
          alt={home.heroImageAlt}
          width={home.heroImageWidth}
          height={home.heroImageHeight}
          class="h-full w-full object-cover object-[50%_85%] sm:object-[50%_75%]"
          fetchpriority="high"
        />
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-blue-tint to-transparent"></div>
      </div>
    ) : (
      <div class="ph h-[clamp(16rem,45vh,32rem)] !rounded-none !border-x-0 !border-t-0" role="img" aria-label={home.heroImageAlt} data-placeholder="Hero image">
        <span class="ph-label" aria-hidden="true">Hero image</span>
        <span class="ph-meta" aria-hidden="true">Recommended 1920 × 1080 px · young people in an activity</span>
      </div>
    )}

    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -right-32 -z-10 size-[28rem] rounded-full bg-blue/30 blur-3xl"></div>
    <div class="container-site pb-16 pt-10 sm:pt-14 lg:pb-24 lg:pt-16">
      <div class="max-w-4xl">
        <h1 id="hero-heading" class="h-hero">
          <span><strong>Guiding Lives</strong> <em>today,</em></span>
          <span class="h-hero-alt"><strong>Building futures</strong> <em>tomorrow.</em></span>
        </h1>
        <p class="hero-copy measure mt-8 text-xl font-medium leading-relaxed text-ink lg:text-2xl">
          A social enterprise for child and youth development in Nigeria, equipping children and young people to thrive academically, psychologically, socially, and personally.
        </p>
        <p class="hero-copy measure mt-5 text-lg leading-relaxed text-ink-soft lg:text-xl">
          We collaborate with parents, schools, communities, and government partners to create nurturing environments where children and young people can learn, grow, and reach their potential.
        </p>
        <p class="hero-copy measure mt-5 text-lg leading-relaxed text-ink-soft lg:text-xl">{servicesIntro}</p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href="/programmes" class="btn btn-primary">Explore Our Programmes<Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </div>

    <a href="#our-services" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-sm font-semibold lg:flex" aria-label="Scroll to Our Services">
      <span class="scroll-cue" aria-hidden="true"></span>
    </a>
  </section>

  <!-- 2. Our Services (directly under the hero) -->
  <section id="our-services" class="section scroll-mt-24" aria-labelledby="services-heading">
    <div class="container-site">
      <h2 id="services-heading" class="fancy-title mb-10 lg:mb-14">Our Services</h2>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
        {services.map((s, i) => (
          <li class:list={["lg:col-span-2", i === 3 && "lg:col-start-2"]}>
            <ServiceCard service={s} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Quote band -->
  <QuoteBand />

  <!-- 5. Impact at a glance -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="impact-heading">
    <div class="container-site">
      <h2 id="impact-heading" class="fancy-title mb-10 lg:mb-14">Our Impact</h2>
      <Stats />
      <div class="reveal mx-auto mt-16 max-w-4xl overflow-hidden rounded-3xl shadow-[var(--shadow-soft)]">
        <img
          src="/images/home/impact-students.webp"
          alt="Secondary school students in light-blue uniforms smiling and taking notes during a Bridge Help Centre session"
          width="858"
          height="588"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
    </div>
  </section>

  <!-- 6. Meet the Director -->
  <DirectorBlock />

  <!-- 7. Upcoming programmes -->
  <section class="section" aria-labelledby="upcoming-heading">
    <div class="container-site">
      <SectionHeading title="Upcoming Programmes" id="upcoming-heading" />
      {featured ? (
        <EventSlideshow event={featured} />
      ) : (
        <>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((e) => <li><EventCard event={e} /></li>)}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- 8. Gallery preview -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="gallery-heading">
    <div class="container-site">
      <SectionHeading title="Moments from Our Work" id="gallery-heading" />
      <Gallery limit={8} layout="grid" id="home-gallery" />
    </div>
  </section>

  <!-- 9. Call to action -->
  <CtaBand />
</Base>
