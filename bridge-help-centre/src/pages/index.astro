---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { srcsetFor } from "../lib/images.js";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import QuoteBand from "../components/QuoteBand.astro";
import Stats from "../components/Stats.astro";
import DirectorBlock from "../components/DirectorBlock.astro";
import EventCard from "../components/EventCard.astro";
import EventSlideshow from "../components/EventSlideshow.astro";
import Gallery from "../components/Gallery.astro";
import CtaBand from "../components/CtaBand.astro";
import { home } from "../data/home.js";
import { services, servicesIntro } from "../data/services.js";
import { events } from "../data/events.js";
import { site } from "../config/site.js";
import Blocks from "../components/Blocks.astro";
import { homeSections } from "../data/home-sections.js";
import { homeText } from "../data/text.js";
import { sizeOf } from "../lib/images.js";
const impactSize = homeText.impact.image ? sizeOf(homeText.impact.image) : undefined;

const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
// The next programme that has slideshow images is featured; otherwise show the next three as cards.
const heroSrcset = srcsetFor(home.heroImage, home.heroImageWidth);
const featured = events.filter((e) => e.date >= today && e.slides?.length).sort((a, b) => a.date.localeCompare(b.date))[0];
// Other upcoming programmes appear as cards below the featured slideshow.
const others = featured ? upcoming.filter((e) => e !== featured) : [];

// Search engines: describe upcoming programmes as events (Nigeria time, UTC+1).
const toIsoTime = (t = "") => {
  const m = t.trim().match(/^(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\.?$/i);
  if (!m) return "";
  let h = Number(m[1]) % 12;
  if (m[3].toLowerCase() === "p") h += 12;
  return `T${String(h).padStart(2, "0")}:${m[2] || "00"}:00+01:00`;
};
const eventSchema = upcoming.map((e) => {
  const online = /online|google meet|zoom|virtual/i.test(e.location || "");
  const pageUrl = new URL("/#upcoming-heading", site.url).href;
  return {
    "@type": "Event",
    name: e.title,
    description: e.description || e.subtitle,
    startDate: e.date + toIsoTime(e.time),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: online ? "https://schema.org/OnlineEventAttendanceMode" : "https://schema.org/OfflineEventAttendanceMode",
    location: online
      ? { "@type": "VirtualLocation", url: e.registerForm || pageUrl }
      : { "@type": "Place", name: e.location || site.name, address: { "@type": "PostalAddress", streetAddress: e.location || site.addressParts.street, addressLocality: site.addressParts.city, addressRegion: site.addressParts.state, addressCountry: "NG" } },
    image: e.image ? [new URL(e.image, site.url).href] : undefined,
    organizer: { "@id": new URL("/#organization", site.url).href },
    ...(e.speaker ? { performer: { "@type": "Person", name: e.speaker } } : {}),
    ...(/^free$/i.test(e.price || "") ? { isAccessibleForFree: true, offers: { "@type": "Offer", price: 0, priceCurrency: "NGN", availability: "https://schema.org/InStock", url: e.registerForm || pageUrl } } : {}),
  };
});
---
<Base
  preloadImage={{ src: home.heroImage, srcset: heroSrcset }}
  title="The Bridge Help Centre"
  description="The Bridge Help Centre in Umuahia, Abia State supports children and young people in Nigeria through counselling, mentorship, learning support and school programmes."
  extraSchema={eventSchema}
>
  <!-- 1. Hero: full-width photo band at the very top, headline below it -->
  <section class="relative isolate overflow-hidden bg-blue-tint" aria-labelledby="hero-heading">
    {home.heroImage ? (
      <div class="relative aspect-[2/1] w-full sm:aspect-auto sm:h-[clamp(16rem,40vw,36rem)]">
        <img
          src={home.heroImage}
          srcset={heroSrcset}
          sizes="100vw"
          alt={home.heroImageAlt}
          width={home.heroImageWidth}
          height={home.heroImageHeight}
          class="h-full w-full object-cover object-[50%_85%] sm:object-[50%_75%]"
          fetchpriority="high"
        />
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-blue-tint to-transparent"></div>
      </div>
    ) : (
      <div class="ph h-[clamp(16rem,45vh,32rem)] !rounded-none !border-x-0 !border-t-0" role="img" aria-label={home.heroImageAlt} data-placeholder="Hero image">
        <span class="ph-label" aria-hidden="true">Hero image</span>
        <span class="ph-meta" aria-hidden="true">Recommended 1920 × 1080 px · young people in an activity</span>
      </div>
    )}

    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -right-32 -z-10 size-[28rem] rounded-full bg-blue/30 blur-3xl"></div>
    <div class="container-site pb-16 pt-10 sm:pt-14 lg:pb-24 lg:pt-16">
      <div class="max-w-4xl">
        <h1 id="hero-heading" class="h-hero">
          <span><strong>{homeText.hero.line1Bold}</strong> <em>{homeText.hero.line1Italic}</em></span>
          <span class="h-hero-alt"><strong>{homeText.hero.line2Bold}</strong> <em>{homeText.hero.line2Italic}</em></span>
        </h1>
        {homeText.hero.paragraph1 && (
          <p class="hero-copy measure mt-8 text-xl font-medium leading-relaxed text-ink lg:text-2xl">
            {homeText.hero.paragraph1}
          </p>
        )}
        {homeText.hero.paragraph2 && (
          <p class="hero-copy measure mt-5 text-lg leading-relaxed text-ink-soft lg:text-xl">
            {homeText.hero.paragraph2}
          </p>
        )}
        <p class="hero-copy measure mt-5 text-lg leading-relaxed text-ink-soft lg:text-xl">{servicesIntro}</p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a href={homeText.hero.buttonLink} class="btn btn-primary">{homeText.hero.buttonLabel}<Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </div>

    <a href="#our-services" class="absolute bottom-4 left-1/2 hidden min-h-14 min-w-11 -translate-x-1/2 flex-col items-center justify-center gap-2 text-sm font-semibold lg:flex" aria-label="Scroll to Our Services">
      <span class="scroll-cue" aria-hidden="true"></span>
    </a>
  </section>

  <!-- 2. Our Services (directly under the hero) -->
  <section id="our-services" class="section scroll-mt-24" aria-labelledby="services-heading">
    <div class="container-site">
      <h2 id="services-heading" class="fancy-title mb-10 lg:mb-14">{homeText.servicesHeading}</h2>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
        {services.map((s, i) => (
          <li class:list={["lg:col-span-2", i === 3 && "lg:col-start-2"]}>
            <ServiceCard service={s} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Quote band -->
  <QuoteBand />

  <!-- 5. Impact at a glance -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="impact-heading">
    <div class="container-site">
      <h2 id="impact-heading" class="fancy-title mb-10 lg:mb-14">{homeText.impact.heading}</h2>
      <Stats />
      {homeText.impact.image && (
        <div class="reveal mx-auto mt-16 max-w-4xl overflow-hidden rounded-3xl shadow-[var(--shadow-soft)]">
          <img
            src={homeText.impact.image}
            srcset={srcsetFor(homeText.impact.image)}
            sizes="(min-width: 1024px) 56rem, 100vw"
            alt={homeText.impact.imageAlt}
            width={impactSize?.width || 858}
            height={impactSize?.height || 588}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </div>
      )}
    </div>
  </section>

  <!-- 6. Meet the Director -->
  <DirectorBlock />

  <!-- 7. Upcoming programmes (hidden when there is nothing coming up) -->
  {(featured || upcoming.length > 0) && (
    <section class="section" aria-labelledby="upcoming-heading" data-upcoming-section>
      <div class="container-site">
        <SectionHeading title={homeText.upcomingHeading} id="upcoming-heading" />
        {featured ? (
          <>
            <EventSlideshow event={featured} />
            {others.length > 0 && (
              <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:mt-14">
                {others.map((e) => <li><EventCard event={e} /></li>)}
              </ul>
            )}
          </>
        ) : (
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {upcoming.map((e) => <li><EventCard event={e} /></li>)}
          </ul>
        )}
      </div>
    </section>
  )}

  <!-- 8. Gallery preview -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="gallery-heading">
    <div class="container-site">
      <SectionHeading title={homeText.galleryHeading} id="gallery-heading" />
      <Gallery limit={8} layout="grid" id="home-gallery" />
    </div>
  </section>

  <!-- 8b. Extra sections added by staff in the online editor -->
  {homeSections.length > 0 && (
    <section class="section pt-0 lg:pt-0" aria-label="More from The Bridge Help Centre">
      <div class="container-site">
        <Blocks blocks={homeSections} id="home-extra" />
      </div>
    </section>
  )}

  <!-- 9. Call to action -->
  <CtaBand />
</Base>
