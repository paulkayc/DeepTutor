---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Media from "../components/Media.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import QuoteBand from "../components/QuoteBand.astro";
import Stats from "../components/Stats.astro";
import StoryCard from "../components/StoryCard.astro";
import DirectorBlock from "../components/DirectorBlock.astro";
import EventCard from "../components/EventCard.astro";
import Gallery from "../components/Gallery.astro";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config/site.js";
import { home } from "../data/home.js";
import { services, servicesIntro } from "../data/services.js";
import { stories } from "../data/stories.js";
import { events } from "../data/events.js";

const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 3);
---
<Base
  title="The Bridge Help Centre"
  description="The Bridge Help Centre is a social enterprise for child and youth development in Nigeria — counselling, mentorship, learning support and school programmes for children and young people."
>
  <!-- 1. Hero: full-width photo band at the very top, headline below it -->
  <section class="relative isolate overflow-hidden bg-blue-tint" aria-labelledby="hero-heading">
    {home.heroImage ? (
      <div class="relative aspect-[2/1] w-full sm:aspect-auto sm:h-[clamp(16rem,40vw,36rem)]">
        <img
          src={home.heroImage}
          alt={home.heroImageAlt}
          width={home.heroImageWidth}
          height={home.heroImageHeight}
          class="h-full w-full object-cover object-[50%_85%] sm:object-[50%_75%]"
          fetchpriority="high"
          decoding="async"
        />
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-blue-tint to-transparent"></div>
      </div>
    ) : (
      <div class="ph h-[clamp(16rem,45vh,32rem)] !rounded-none !border-x-0 !border-t-0" role="img" aria-label={home.heroImageAlt} data-placeholder="Hero image">
        <span class="ph-label" aria-hidden="true">Hero image</span>
        <span class="ph-meta" aria-hidden="true">Recommended 1920 × 1080 px · young people in an activity</span>
      </div>
    )}

    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -right-32 -z-10 size-[28rem] rounded-full bg-blue/30 blur-3xl"></div>
    <div class="container-site pb-16 pt-10 sm:pt-14 lg:pb-24 lg:pt-16">
      <div class="max-w-4xl">
        <h1 id="hero-heading" class="h-display">
          <span class="block">Guiding <span class="text-magenta">lives</span> today.</span>
          <span class="block">Building <span class="text-magenta">futures</span> tomorrow.</span>
        </h1>
        <p class="measure mt-7 text-xl leading-relaxed text-ink lg:text-[1.375rem]">
          A social enterprise for child and youth development in Nigeria, equipping children and young people to thrive academically, psychologically, socially, and personally.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row" data-hide-floats>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="whatsapp" />Chat on WhatsApp</a>
          <a href="/programmes" class="btn btn-secondary">Explore Our Programmes</a>
        </div>
      </div>
    </div>

    <a href="#who-we-are" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-sm font-semibold lg:flex" aria-label="Scroll to Who We Are">
      <span class="scroll-cue" aria-hidden="true"></span>
    </a>
  </section>

  <!-- 2. Introduction -->
  <section id="who-we-are" class="section" aria-labelledby="intro-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Who We Are</p>
        <h2 id="intro-heading" class="h-section max-w-xl">Walking with young people, every step of the way</h2>
        <p class="lead measure mt-6">We collaborate with parents, schools, communities, and government partners to create nurturing environments where children and young people can learn, grow, and reach their potential.</p>
        <a href="/about" class="link-arrow mt-8">Learn about our story<Icon name="arrow" size={20} /></a>
      </div>
      <div class="reveal w-full">
        <Media src={home.introImage} alt={home.introImageAlt} label="Introduction photo" size="1536 × 1024 px" hint="A facilitator alongside young people — warm and candid." ratio="3 / 2" width={1536} height={1024} class="shadow-[var(--shadow-soft)]" />
      </div>
    </div>
  </section>

  <!-- 3. Key programmes -->
  <section class="section section-tint" aria-labelledby="services-heading">
    <div class="container-site">
      <SectionHeading eyebrow="What We Do" title="Our Services" id="services-heading">
        <p class="lead measure mt-5">{servicesIntro}</p>
      </SectionHeading>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
        {services.map((s, i) => (
          <li class:list={["lg:col-span-2", i === 3 && "lg:col-start-2"]}>
            <ServiceCard service={s} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Quote band -->
  <QuoteBand />

  <!-- 5. Impact at a glance -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="impact-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Our Impact" title="Change you can count — and stories you can feel" id="impact-heading" />
      <Stats />
      <div class="mt-16">
        <StoryCard story={stories[0]} featured>
          <div class="mt-8">
            <a href="/impact" class="btn btn-secondary">Read More Stories</a>
          </div>
        </StoryCard>
      </div>
    </div>
  </section>

  <!-- 6. Meet the Director -->
  <DirectorBlock />

  <!-- 7. Upcoming programmes -->
  <section class="section" aria-labelledby="upcoming-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Coming Up" title="Upcoming Programmes" id="upcoming-heading" />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {upcoming.map((e) => <li><EventCard event={e} /></li>)}
      </ul>
      <div class="mt-12">
        <a href="/resources#upcoming" class="btn btn-secondary">See All Programmes</a>
      </div>
    </div>
  </section>

  <!-- 8. Gallery preview -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="gallery-heading">
    <div class="container-site">
      <SectionHeading title="Moments from Our Work" id="gallery-heading" />
      <Gallery limit={8} layout="grid" id="home-gallery" />
      <a href="/impact#gallery" class="link-arrow mt-8">View Full Gallery<Icon name="arrow" size={20} /></a>
    </div>
  </section>

  <!-- 9. Call to action -->
  <CtaBand />
</Base>
