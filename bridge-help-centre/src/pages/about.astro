---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Media from "../components/Media.astro";
import Icon from "../components/Icon.astro";
import DirectorBlock from "../components/DirectorBlock.astro";
import CtaBand from "../components/CtaBand.astro";
import { story, vision, mission, values, team } from "../data/about.js";
const isPlaceholder = (t: string) => t.trim().startsWith("[");
---
<Base
  title="About Us"
  description="Our story, vision, mission and values — and the leadership of Mrs. Amarachi Ikonne, Director of The Bridge Help Centre in Nigeria."
>
  <PageHero
    title="About The Bridge Help Centre"
    subtitle="A social enterprise for child and youth development in Nigeria, equipping children and young people to thrive academically, psychologically, socially, and personally."
  />

  <!-- Our Story -->
  <section class="section" aria-labelledby="story-heading">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <Media src={story.image} alt={story.imageAlt} label="Our Story photo" size="1200 × 800 px" hint="A photo from the centre's early days or a defining moment." ratio="3 / 2" width={795} height={530} class="shadow-[var(--shadow-soft)]" />
      </div>
      <div class="reveal">
        <h2 id="story-heading" class="h-section">Our Story</h2>
        <div class="hero-copy measure mt-6 space-y-5 text-lg leading-relaxed lg:text-[1.1875rem]">
          {story.paragraphs.map((p, i) => (
            <p class:list={[isPlaceholder(p) && "placeholder-text", i === 0 && isPlaceholder(p) && "rounded-xl border-2 border-dashed border-blue bg-blue-tint px-4 py-3 font-bold not-italic text-ink"]}>{p}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="section pt-0 lg:pt-0" aria-label="Vision and mission">
    <div class="container-site grid gap-6 md:grid-cols-2 lg:gap-8">
      <article class="card reveal">
        <Icon name="eye" size={52} class="text-magenta" />
        <h2 class="h-sub mt-6 !text-3xl !font-bold">Our Vision</h2>
        <p class:list={["hero-copy mt-4 text-lg leading-relaxed lg:text-xl", isPlaceholder(vision) && "placeholder-text"]}>{vision}</p>
      </article>
      <article class="card reveal">
        <Icon name="target" size={52} class="text-magenta" />
        <h2 class="h-sub mt-6 !text-3xl !font-bold">Our Mission</h2>
        <p class="hero-copy mt-4 text-lg leading-relaxed lg:text-xl">{mission}</p>
      </article>
    </div>
  </section>

  <!-- Values (editable in src/data/about.js) -->
  <section class="section pt-0 lg:pt-0" aria-labelledby="values-heading">
    <div class="container-site">
      <SectionHeading title="What We Stand For" id="values-heading" />
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {values.map((v) => (
          <li class="card reveal flex gap-5 !p-7">
            <span class="icon-badge !bg-blue-tint"><Icon name={v.icon} size={26} /></span>
            <div>
              <h3 class="text-xl font-extrabold">{v.name}</h3>
              <p class="mt-1.5 text-ink-soft">{v.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Leadership -->
  <DirectorBlock id="leadership" />

  {team.length > 0 && (
    <section class="section" aria-labelledby="team-heading">
      <div class="container-site">
        <SectionHeading title="Our Team" id="team-heading" />
        {/* Optional: edit or remove the team array in src/data/about.js */}
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((m) => (
            <li class="reveal">
              <Media src={m.photo} alt={m.photoAlt || `Photo of ${m.name}`} label="Team photo" size="800 × 800 px" ratio="1 / 1" width={800} height={800} class="shadow-[var(--shadow-soft)]" />
              <h3 class="mt-5 font-[family-name:var(--font-display)] text-2xl font-bold">{m.name}</h3>
              <p class:list={["mt-1 font-semibold", isPlaceholder(m.role) ? "placeholder-text" : "text-magenta-deep"]}>{m.role}</p>
              {m.profession && <p class="text-ink-soft">{m.profession}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
