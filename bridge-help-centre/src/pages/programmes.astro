---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Media from "../components/Media.astro";
import Icon from "../components/Icon.astro";
import { srcsetFor, sizeOf } from "../lib/images.js";
import { programsPage } from "../data/programs-page.js";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config/site.js";
import { services, servicesIntro } from "../data/services.js";
import { pageText } from "../data/text.js";
const t = pageText.programs;

// Header flyer and "Who is this for?" cards come from the editor ("Our Programs page").
const { flyer, audience, programLabel, enquireLabel } = programsPage;
const flyerIsPast = Boolean(flyer.date) && flyer.date < new Date().toISOString().slice(0, 10);
const flyerSize = flyer.image ? sizeOf(flyer.image) : undefined;
const isExternal = (href: string) => /^https?:\/\//i.test(href) && !/thebridgehelpcentre\.org/i.test(href);
---
<Base
  title={t.menuLabel}
  description="Counselling, mentorship and life skills, special education and learning support, school outreaches and youth empowerment in Umuahia, Abia State and across Nigeria."
>
  <PageHero title={t.heading} subtitle={servicesIntro}>
    {flyer.image && (
      <a slot="aside" href={flyer.image} target="_blank" rel="noopener" class="relative mx-auto block max-w-md overflow-hidden rounded-3xl shadow-[var(--shadow-lift)] transition hover:-translate-y-1 lg:max-w-none" title="Open full size">
        {flyerIsPast && (
          <span class="absolute left-4 top-4 z-10 inline-flex items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-sm font-extrabold uppercase tracking-wider text-ink shadow-[var(--shadow-soft)]">
            <span class="size-2 rounded-full bg-ink-soft" aria-hidden="true"></span>Past program
          </span>
        )}
        <img
          src={flyer.image}
          srcset={srcsetFor(flyer.image)}
          sizes="(min-width: 1024px) 40vw, (min-width: 448px) 28rem, 100vw"
          alt={flyer.imageAlt}
          width={flyerSize?.width || 1080}
          height={flyerSize?.height || 1080}
          fetchpriority="high"
          decoding="async"
          class="block h-auto w-full"
        />
      </a>
    )}
  </PageHero>

  <!-- Sticky in-page navigation -->
  <nav aria-label="Programs on this page" class="sticky top-20 z-20 border-b-2 border-blue-tint bg-white/95 backdrop-blur lg:top-24">
    <ul class="container-site flex gap-2 overflow-x-auto py-3 [scrollbar-width:thin]">
      {services.map((s) => (
        <li class="shrink-0">
          <a href={`#${s.id}`} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-blue-tint px-4 text-[0.9375rem] font-bold transition-colors hover:bg-blue">
            <span class="text-magenta-deep">{s.number}</span> {s.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {services.map((s, i) => (
    <section id={s.id} class:list={["section scroll-mt-40", i % 2 === 1 && "section-tint"]} aria-labelledby={`${s.id}-heading`}>
      <div class:list={["container-site grid items-center gap-12 lg:gap-20", s.image && "lg:grid-cols-2"]}>
        {s.image && (
          <div class:list={["reveal", i % 2 === 1 && "lg:order-2"]}>
            <Media src={s.image} alt={s.imageAlt} label={`Program ${s.number} photo`} size="1200 × 900 px" hint={s.imageHint} ratio="4 / 3" class="shadow-[var(--shadow-soft)]" />
          </div>
        )}
        <div class:list={["reveal", !s.image && "max-w-3xl"]}>
          <p class="eyebrow">{programLabel} {s.number}</p>
          <h2 id={`${s.id}-heading`} class="h-section">{s.name}</h2>
          {s.bullets.length > 0 ? (
            <ul class="tick-list mt-8 text-lg">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          ) : s.summary && <p class="lead mt-6">{s.summary}</p>}
          {s.buttons.length > 0 && (
            <ul class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" aria-label={`${s.name}: choose a program`}>
              {s.buttons.map((btn) => {
                const href = btn.link || whatsappLink(`Hello, I would like to know more about the ${btn.label}`);
                const external = !btn.link || isExternal(btn.link);
                return (
                  <li>
                    <a href={href} class="btn btn-secondary w-full sm:w-auto" {...(external ? { target: "_blank", rel: "noopener" } : {})}>
                      {btn.label}<Icon name="arrow" size={20} />{!btn.link && <span class="sr-only"> (opens WhatsApp)</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          <a href={whatsappLink(`Hello, I would like to enquire about ${s.name}`)} target="_blank" rel="noopener" class:list={["btn btn-primary", s.buttons.length ? "mt-6" : "mt-10"]}>
            <Icon name="whatsapp" />{enquireLabel}<span class="sr-only"> about {s.name}</span>
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- Who is this for? (hidden when there are no cards) -->
  {audience.cards.length > 0 && (
  <section class="section" aria-labelledby="who-heading">
    <div class="container-site">
      <SectionHeading eyebrow={audience.eyebrow || undefined} title={audience.heading} id="who-heading" />
      <ul class="grid gap-6 md:grid-cols-3">
        {audience.cards.map((a) => (
          <li class="card card-hover reveal flex flex-col">
            <span class="icon-badge"><Icon name={a.icon} size={28} /></span>
            <h3 class="h-sub mt-6">{a.title}</h3>
            <p class="mt-3 text-ink-soft">{a.text}</p>
            {a.href && a.linkLabel && <a href={a.href} class="link-arrow mt-auto pt-5">{a.linkLabel}<Icon name="arrow" size={20} /></a>}
          </li>
        ))}
      </ul>
    </div>
  </section>
  )}

  <CtaBand />
</Base>
