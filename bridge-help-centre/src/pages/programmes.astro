---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Media from "../components/Media.astro";
import Icon from "../components/Icon.astro";
import { srcsetFor } from "../lib/images.js";
import CtaBand from "../components/CtaBand.astro";
import { whatsappLink } from "../config/site.js";
import { services, servicesIntro } from "../data/services.js";
import { pageText } from "../data/text.js";
const t = pageText.programs;

// Header flyer: "My Why, My Focus, My Future" (1 Oct 2026). Shows a "Past program" tag after its date.
const flyerDate = "2026-10-01";
const flyerIsPast = flyerDate < new Date().toISOString().slice(0, 10);

const audiences = [
  {
    title: "For Parents",
    icon: "heart",
    text: "Worried about your child's learning, feelings or confidence? Start with counselling or learning support.",
    href: "#counselling",
    link: "Explore our counselling services",
  },
  {
    title: "For Schools",
    icon: "school",
    text: "Bring outreaches, educational talks, career guidance and teacher training to your students and staff.",
    href: "#school-development",
    link: "Explore our school programs",
  },
  {
    title: "For Communities & Partners",
    icon: "community",
    text: "Run leadership, safety and girls' programs with us for young people who need it most.",
    href: "#community",
    link: "Explore youth and community empowerment",
  },
];
---
<Base
  title={t.menuLabel}
  description="Counselling, mentorship and life skills, special education and learning support, school outreaches and youth empowerment in Umuahia, Abia State and across Nigeria."
>
  <PageHero title={t.heading} subtitle={servicesIntro}>
    <a slot="aside" href="/images/gallery/my-why-my-focus-flyer.webp" target="_blank" rel="noopener" class="relative mx-auto block max-w-md overflow-hidden rounded-3xl shadow-[var(--shadow-lift)] transition hover:-translate-y-1 lg:max-w-none" title="Open full size">
      {flyerIsPast && (
        <span class="absolute left-4 top-4 z-10 inline-flex items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-sm font-extrabold uppercase tracking-wider text-ink shadow-[var(--shadow-soft)]">
          <span class="size-2 rounded-full bg-ink-soft" aria-hidden="true"></span>Past program
        </span>
      )}
      <img
        src="/images/gallery/my-why-my-focus-flyer.webp"
        srcset={srcsetFor("/images/gallery/my-why-my-focus-flyer.webp")}
        sizes="(min-width: 1024px) 40vw, (min-width: 448px) 28rem, 100vw"
        alt="Flyer for 'My Why, My Focus, My Future', a student development program for ages 10 to 18 with facilitator Amara Ikonne: understanding why I am in school, developing focus, and taking ownership of my future. 1st October 2026, 11 AM on Google Meet. Contact 09026433052. This program has already taken place."
        width="1080"
        height="1080"
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full"
      />
    </a>
  </PageHero>

  <!-- Sticky in-page navigation -->
  <nav aria-label="Programs on this page" class="sticky top-20 z-20 border-b-2 border-blue-tint bg-white/95 backdrop-blur lg:top-24">
    <ul class="container-site flex gap-2 overflow-x-auto py-3 [scrollbar-width:thin]">
      {services.map((s) => (
        <li class="shrink-0">
          <a href={`#${s.id}`} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-blue-tint px-4 text-[0.9375rem] font-bold transition-colors hover:bg-blue">
            <span class="text-magenta-deep">{s.number}</span> {s.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {services.map((s, i) => (
    <section id={s.id} class:list={["section scroll-mt-40", i % 2 === 1 && "section-tint"]} aria-labelledby={`${s.id}-heading`}>
      <div class:list={["container-site grid items-center gap-12 lg:gap-20", s.image && "lg:grid-cols-2"]}>
        {s.image && (
          <div class:list={["reveal", i % 2 === 1 && "lg:order-2"]}>
            <Media src={s.image} alt={s.imageAlt} label={`Program ${s.number} photo`} size="1200 × 900 px" hint={s.imageHint} ratio="4 / 3" class="shadow-[var(--shadow-soft)]" />
          </div>
        )}
        <div class:list={["reveal", !s.image && "max-w-3xl"]}>
          <p class="eyebrow">Program {s.number}</p>
          <h2 id={`${s.id}-heading`} class="h-section">{s.name}</h2>
          {s.bullets.length > 0 ? (
            <ul class="tick-list mt-8 text-lg">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          ) : s.summary && <p class="lead mt-6">{s.summary}</p>}
          <a href={whatsappLink(`Hello, I would like to enquire about ${s.name}`)} target="_blank" rel="noopener" class="btn btn-primary mt-10">
            <Icon name="whatsapp" />Enquire on WhatsApp<span class="sr-only"> about {s.name}</span>
          </a>
        </div>
      </div>
    </section>
  ))}

  <!-- Who is this for? -->
  <section class="section" aria-labelledby="who-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Find your starting point" title="Who is this for?" id="who-heading" />
      <ul class="grid gap-6 md:grid-cols-3">
        {audiences.map((a) => (
          <li class="card card-hover reveal flex flex-col">
            <span class="icon-badge"><Icon name={a.icon} size={28} /></span>
            <h3 class="h-sub mt-6">{a.title}</h3>
            <p class="mt-3 text-ink-soft">{a.text}</p>
            <a href={a.href} class="link-arrow mt-auto pt-5">{a.link}<Icon name="arrow" size={20} /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
