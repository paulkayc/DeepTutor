---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Stats from "../components/Stats.astro";
import StoryCard from "../components/StoryCard.astro";
import DocCard from "../components/DocCard.astro";
import Gallery from "../components/Gallery.astro";
import CtaBand from "../components/CtaBand.astro";
import { stories } from "../data/stories.js";
import { milestones } from "../data/about.js";
import { reports } from "../data/resources.js";
/* STORIES: publish only with consent from the young person and their parent
   or guardian; change names and identifying details where needed.
   Edit them in src/data/stories.js. */
---
<Base
  title="Our Impact"
  description="Stories of change, milestones, reports and photos from The Bridge Help Centre's work with children and young people in Nigeria."
>
  <PageHero eyebrow="Our Impact" title="Our Impact" subtitle="Real young people, real change, one conversation at a time." />

  <section class="section" aria-labelledby="numbers-heading">
    <div class="container-site">
      <SectionHeading title="Our work in numbers" id="numbers-heading" />
      <Stats large showNote />
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="stories-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Young people first" title="Stories of Change" id="stories-heading">
        <p class="lead measure mt-5">What they faced, how we walked alongside them, and where they are now.</p>
      </SectionHeading>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {stories.map((s) => <li class="flex"><StoryCard story={s} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="milestones-heading">
    <div class="container-site grid gap-12 lg:grid-cols-[4fr_8fr] lg:gap-20">
      <SectionHeading eyebrow="Our journey" title="Milestones" id="milestones-heading">
        <p class="mt-5 text-ink-soft">Add a new milestone with one line in <code class="text-sm">src/data/about.js</code>.</p>
      </SectionHeading>
      <ol class="timeline space-y-10">
        {milestones.map((m) => (
          <li class="reveal relative pl-14">
            <span class="timeline-dot" aria-hidden="true"></span>
            <p class="text-sm font-extrabold uppercase tracking-wider text-magenta-deep">{m.year}</p>
            <p class="placeholder-text mt-1 text-lg">{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="reports-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Accountability" title="Reports" id="reports-heading" />
      <ul class="grid gap-6 md:grid-cols-3">
        {reports.map((r) => <li class="flex [&>*]:w-full"><DocCard doc={r} /></li>)}
      </ul>
    </div>
  </section>

  <section id="gallery" class="section scroll-mt-24" aria-labelledby="gallery-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Moments" title="Gallery" id="gallery-heading" />
      <Gallery filters id="impact-gallery" />
    </div>
  </section>

  <CtaBand title="Help us reach more young people" primary={{ label: "Partner With Us", href: "/get-involved" }} />
</Base>
