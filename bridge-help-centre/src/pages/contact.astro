---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import FormShell from "../components/FormShell.astro";
import FormField from "../components/FormField.astro";
import { site, whatsappLink, telLink } from "../config/site.js";
import { services } from "../data/services.js";
---
<Base
  title="Contact Us"
  description="Call 0902 643 3052, chat on WhatsApp or email thebridgehelpcenter@gmail.com. Open Monday to Friday, 10am to 4pm."
>
  <PageHero title="Contact Us" subtitle="We would love to hear from you." />

  <section class="section" aria-label="Contact details and enquiry form">
    <div class="container-site grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
      <!-- Contact details -->
      <div class="card h-fit lg:sticky lg:top-32">
        <h2 class="sr-only">Contact details</h2>
        <ul class="-mt-5 divide-y divide-blue-tint">
          <li class="flex gap-4 py-5">
            <span class="icon-badge !size-12"><Icon name="phone" /></span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-ink-soft">Phone</p>
              <a href={telLink} class="link text-lg">{site.phone.display}</a>
            </div>
          </li>
          <li class="flex gap-4 py-5">
            <span class="icon-badge !size-12"><Icon name="mail" /></span>
            <div class="min-w-0">
              <p class="text-sm font-bold uppercase tracking-wider text-ink-soft">Email</p>
              <a href={`mailto:${site.email}`} class="link break-all text-lg">{site.email}</a>
            </div>
          </li>
          <li class="flex gap-4 py-5">
            <span class="icon-badge !size-12"><Icon name="clock" /></span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-ink-soft">Hours</p>
              <ul class="mt-1">
                {site.hours.map((h) => <li><span class="font-semibold">{h.days}:</span> {h.time}</li>)}
              </ul>
            </div>
          </li>
          <li class="flex gap-4 py-5">
            <span class="icon-badge !size-12"><Icon name="pin" /></span>
            <div>
              <p class="text-sm font-bold uppercase tracking-wider text-ink-soft">Address</p>
              {site.address ? <address class="not-italic"><a href={site.mapLink} target="_blank" rel="noopener" class="link text-lg">{site.address}</a></address> : <p class="placeholder-text">[Add office address]</p>}
            </div>
          </li>
          {site.social.length > 0 && (
            <li class="py-5">
              <p class="text-sm font-bold uppercase tracking-wider text-ink-soft">Follow us</p>
              <ul class="mt-3 flex flex-wrap gap-3">
                {site.social.map((sm) => (
                  <li>
                    <a href={sm.url} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2.5 rounded-full border-2 border-blue bg-white px-4 font-bold transition hover:-translate-y-0.5 hover:border-magenta hover:text-magenta-deep">
                      <Icon name={sm.icon} size={22} />{sm.name}<span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          )}
        </ul>
        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-primary !px-5"><Icon name="whatsapp" />Chat on WhatsApp</a>
          <a href={`mailto:${site.email}?subject=${encodeURIComponent("Enquiry from the website")}`} class="btn btn-secondary !px-5"><Icon name="mail" />Send an Email</a>
        </div>
      </div>

      <!-- Enquiry form -->
      <div>
        <h2 class="h-section">Send us a message</h2>
        <p class="mt-3 mb-8 text-ink-soft">Tell us a little about what you need and we will reply within two working days.</p>
        <FormShell id="contact-form" endpoint={site.forms.contactEndpoint} subject="New enquiry — website contact form" submitLabel="Send Message">
          <FormField formId="contact" name="name" label="Full name" required autocomplete="name" />
          <div class="grid gap-6 sm:grid-cols-2">
            <FormField formId="contact" name="email" label="Email" type="email" required autocomplete="email" />
            <FormField formId="contact" name="phone" label="Phone number" type="tel" autocomplete="tel" />
          </div>
          <div class="grid gap-6 sm:grid-cols-2">
            <FormField formId="contact" name="role" label="I am a" required options={["Parent", "School", "Young person", "Organisation or partner", "Other"]} />
            <FormField formId="contact" name="service" label="Service of interest" options={[...services.map((s) => s.name), "Not sure yet"]} />
          </div>
          <FormField formId="contact" name="message" label="Message" type="textarea" required />
        </FormShell>
      </div>
    </div>
  </section>

  <!-- Map (lazy-loaded). Set site.mapEmbedUrl in src/config/site.js. -->
  <section class="pb-16 lg:pb-28" aria-labelledby="map-heading">
    <div class="container-site">
      <h2 id="map-heading" class="sr-only">Map</h2>
      {site.mapEmbedUrl ? (
        <>
          <div class="relative overflow-hidden rounded-3xl bg-blue-tint shadow-[var(--shadow-soft)]">
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-6 text-center" aria-hidden="true">
              <Icon name="pin" size={36} class="text-magenta" />
              <span class="font-bold">{site.address}</span>
            </div>
            <iframe src={site.mapEmbedUrl} title={`Map showing The Bridge Help Centre at ${site.address}`} class="relative block h-[320px] w-full border-0 lg:h-[420px]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
          <div class="mt-6 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="flex items-center gap-2 font-semibold"><Icon name="pin" size={20} class="text-magenta-deep" />{site.address}</p>
            <a href={site.mapLink} target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Get directions<Icon name="arrow" size={18} /><span class="sr-only"> in Google Maps (opens in a new tab)</span></a>
          </div>
        </>
      ) : (
        <div class="ph h-[320px] lg:h-[420px]" role="img" aria-label="Map placeholder — the centre's location will be shown here">
          <Icon name="pin" size={36} class="ph-icon" />
          <span class="ph-label" aria-hidden="true">Map placeholder</span>
          <span class="ph-meta" aria-hidden="true">Paste a Google Maps embed link into site.mapEmbedUrl</span>
        </div>
      )}
    </div>
  </section>
</Base>
