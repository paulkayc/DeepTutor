---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EventCard from "../components/EventCard.astro";
import DocCard from "../components/DocCard.astro";
import Media from "../components/Media.astro";
import Icon from "../components/Icon.astro";
import { site, isPlaceholderEndpoint } from "../config/site.js";
import { events } from "../data/events.js";
import { articles } from "../data/articles.js";
import { materials, publications } from "../data/resources.js";

/* Events are edited in src/data/events.js (add/remove one { … } block).
   Upcoming: soonest first. Past events move into "Past Programmes"
   automatically at build time and again in the browser (see scripts/main.js). */
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = events.filter((e) => e.date < today).sort((a, b) => b.date.localeCompare(a.date));
const fmt = (d: string) => new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const tabNames = Object.keys(materials);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, "-");
---
<Base
  title="Resources"
  description="Upcoming programmes, articles, news, publications and free educational materials for parents, teachers and young people."
>
  <PageHero eyebrow="Resources" title="Resources" subtitle="Articles, materials and news for parents, teachers and young people." />

  <section id="upcoming" class="section scroll-mt-24" aria-labelledby="upcoming-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Coming Up" title="Upcoming Programmes" id="upcoming-heading" />
      <ul class="grid gap-6" data-upcoming-list>
        {upcoming.map((e) => <li><EventCard event={e} layout="row" /></li>)}
      </ul>
      <p class="mt-6 text-ink-soft" data-upcoming-empty hidden={upcoming.length > 0}>New programmes are being planned. Chat with us on WhatsApp to hear first.</p>

      <details class="mt-12 rounded-3xl bg-blue-tint">
        <summary class="flex min-h-16 items-center justify-between gap-4 px-7 py-4 text-xl font-bold">
          Past Programmes
          <Icon name="chevronDown" size={24} class="accordion-chevron transition-transform" />
        </summary>
        <div class="px-7 pb-7">
          <ul class="grid gap-4" data-past-list>
            {past.map((e) => (
              <li>
                <article class="flex flex-col gap-1 rounded-2xl bg-white p-5 sm:flex-row sm:items-center sm:gap-6" data-event-date={e.date}>
                  <time datetime={e.date} class="shrink-0 font-bold text-magenta-deep">{fmt(e.date)}</time>
                  <h3 class="font-bold">{e.title}</h3>
                </article>
              </li>
            ))}
          </ul>
          <p class="text-ink-soft" data-past-empty hidden={past.length > 0}>Past programmes will appear here automatically after their date.</p>
        </div>
      </details>
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="articles-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Read" title="Articles & News" id="articles-heading" />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((a) => (
          <li class="flex">
            <article class="card card-hover reveal flex w-full flex-col !p-0 overflow-hidden">
              <Media src={a.image} alt={`Image for ${a.title}`} label="Article image" size="1200 × 800 px" ratio="3 / 2" class="!rounded-none !border-x-0 !border-t-0" />
              <div class="flex flex-1 flex-col p-7">
                <div class="flex flex-wrap items-center gap-3 text-sm">
                  <span class="chip">{a.category}</span>
                  <time datetime={a.date} class="text-ink-soft">{fmt(a.date)}</time>
                </div>
                <h3 class="h-sub mt-4 !text-xl">{a.title}</h3>
                <p class="mt-3 line-clamp-2 text-ink-soft">{a.excerpt}</p>
                <a href={`/resources/articles/${a.slug}`} class="link-arrow mt-auto pt-5">Read more<span class="sr-only">: {a.title}</span><Icon name="arrow" size={20} /></a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="materials-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Free to download" title="Materials for Parents, Teachers and Young People" id="materials-heading" />
      <div data-tabs>
        <div role="tablist" aria-label="Choose an audience" class="js-only mb-8 flex flex-wrap gap-2.5">
          {tabNames.map((t, i) => (
            <button type="button" role="tab" id={`tab-${slug(t)}`} aria-controls={`panel-${slug(t)}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} class="filter-chip">{t}</button>
          ))}
        </div>
        {tabNames.map((t) => (
          <div role="tabpanel" id={`panel-${slug(t)}`} aria-labelledby={`tab-${slug(t)}`} tabindex="0" class="mb-10 rounded-3xl focus-visible:outline-offset-8">
            <h3 class="no-js-only mb-5 text-2xl font-bold">{t}</h3>
            <ul class="grid gap-6 md:grid-cols-3">
              {materials[t].map((m) => <li class="flex [&>*]:w-full"><DocCard doc={m} variant="icon" action="Download" /></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-0 lg:pt-0" aria-labelledby="publications-heading">
    <div class="container-site">
      <SectionHeading eyebrow="Research & guides" title="Publications" id="publications-heading" />
      <ul class="grid gap-6 md:grid-cols-3">
        {publications.map((p) => <li class="flex [&>*]:w-full"><DocCard doc={p} /></li>)}
      </ul>
    </div>
  </section>

  <!-- Newsletter (optional — endpoint in src/config/site.js → forms.newsletterEndpoint) -->
  <section class="section section-tint" aria-labelledby="newsletter-heading">
    <div class="container-site grid items-center gap-8 lg:grid-cols-2">
      <div>
        <h2 id="newsletter-heading" class="h-section">Stay in the loop</h2>
        <p class="mt-4 text-ink-soft">Occasional news, programme dates and helpful resources. No spam — unsubscribe any time.</p>
      </div>
      <div>
        <form action={site.forms.newsletterEndpoint} method="POST" class="flex flex-col gap-3 sm:flex-row" data-form id="newsletter-form" novalidate data-unconfigured={isPlaceholderEndpoint(site.forms.newsletterEndpoint) ? "true" : undefined}>
          <input type="hidden" name="_subject" value="New newsletter subscriber" />
          <p class="sr-only" data-form-summary role="alert"></p>
          <div class="field flex-1">
            <label for="newsletter-form-email" class="sr-only">Email address</label>
            <input id="newsletter-form-email" name="email" type="email" required autocomplete="email" placeholder="Your email address" class="input" aria-describedby="newsletter-form-email-error" />
            <p id="newsletter-form-email-error" class="field-error" aria-live="polite"></p>
          </div>
          <div data-hide-floats><button type="submit" class="btn btn-primary w-full sm:w-auto" data-submit>Subscribe</button></div>
        </form>
        <div class="hidden rounded-2xl bg-white p-6 font-semibold" role="status" tabindex="-1" data-form-success="newsletter-form">Thank you — you're on the list!</div>
        <div class="hidden rounded-2xl bg-white p-6" role="alert" tabindex="-1" data-form-failure="newsletter-form">Sign-ups are not open just yet. Please <a class="link" href={`mailto:${site.email}?subject=${encodeURIComponent("Please add me to your newsletter")}`}>email us</a> and we will add you.</div>
      </div>
    </div>
  </section>
</Base>
