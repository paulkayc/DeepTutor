---
import Media from "./Media.astro";
import Icon from "./Icon.astro";
interface Props { doc: { title: string; year?: string; cover?: string; file?: string; description?: string }; variant?: "cover" | "icon"; action?: string }
const { doc, variant = "cover", action = "Download PDF" } = Astro.props;
---
<article class="card card-hover reveal flex flex-col !p-0 overflow-hidden">
  {variant === "cover" ? (
    <Media src={doc.cover} alt={`Cover of ${doc.title}`} label="Report cover" size="800 × 1000 px" ratio="4 / 3" class="!rounded-none !border-x-0 !border-t-0" />
  ) : null}
  <div class="flex flex-1 flex-col p-7">
    {variant === "icon" && <span class="icon-badge mb-5"><Icon name="file" size={26} /></span>}
    {doc.year && <p class="text-sm font-bold text-magenta-deep">{doc.year}</p>}
    <h3 class="h-sub mt-1 !text-xl">{doc.title}</h3>
    {doc.description && <p class="mt-2 text-ink-soft">{doc.description}</p>}
    <div class="mt-auto pt-6">
      {doc.file ? (
        <a href={doc.file} class="btn btn-secondary btn-sm" download><Icon name="download" size={20} />{action}<span class="sr-only">: {doc.title}</span></a>
      ) : (
        <span class="chip !bg-blue-tint">Coming soon</span>
      )}
    </div>
  </div>
</article>
