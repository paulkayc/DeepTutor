---
import { site, telLink } from "../config/site.js";
import { footerLinks } from "../data/pages.js";
import { footerText } from "../data/text.js";
// Staff can set their own quick links in the editor; otherwise the menu pages are listed.
const nav = footerText.quickLinks.length ? footerText.quickLinks : footerLinks;
import { services } from "../data/services.js";
import Icon from "./Icon.astro";
---
<footer class="bg-blue-tint pb-28 text-ink sm:pb-10" data-hide-floats>
  <div class="container-site grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1fr_1.3fr_1.3fr] lg:py-20">
    <nav aria-labelledby="footer-pages">
      <h2 id="footer-pages" class="text-base font-extrabold">{footerText.quickLinksHeading}</h2>
      <ul class="mt-4">
        {nav.map((item) => (
          <li><a href={item.href} class="inline-flex min-h-11 items-center hover:text-magenta-deep hover:underline">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class="text-base font-extrabold">{footerText.servicesHeading}</h2>
      <ul class="mt-4">
        {services.map((s) => (
          <li><a href={`/programmes/#${s.id}`} class="inline-flex min-h-11 items-center py-1 leading-snug hover:text-magenta-deep hover:underline">{s.name}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-base font-extrabold">{footerText.contactHeading}</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <a href={telLink} class="inline-flex min-h-11 items-center gap-3 font-semibold hover:text-magenta-deep">
            <Icon name="phone" size={20} /> <span><span class="sr-only">Phone: </span>{site.phone.display}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center gap-3 font-semibold break-all hover:text-magenta-deep">
            <Icon name="mail" size={20} class="shrink-0" /> <span><span class="sr-only">Email: </span>{site.email}</span>
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="clock" size={20} class="mt-1 shrink-0" />
          <div>
            <span class="sr-only">Opening hours: </span>
            {site.hours.map((h) => <span class="block">{h.days}: {h.time}</span>)}
          </div>
        </li>
      </ul>
      <h3 class="mt-8 text-base font-extrabold">{footerText.followHeading}</h3>
      <ul class="mt-3 flex gap-2" aria-label="Social media">
        {site.social.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="inline-flex size-11 items-center justify-center rounded-full bg-white text-ink shadow-[var(--shadow-soft)] transition-colors hover:text-magenta-deep" aria-label={`${site.name} on ${s.name} (opens in a new tab)`}>
              <Icon name={s.icon} size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container-site flex flex-col gap-2 border-t border-blue py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      {footerText.registrationText && <p>{footerText.registrationText}</p>}
      <p>{footerText.copyrightText}</p>
    </div>
    <a href={site.privacyPolicyUrl} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">{footerText.privacyLabel}</a>
  </div>
</footer>
