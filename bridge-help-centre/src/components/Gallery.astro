---
/* Gallery grid + accessible lightbox. Images come from src/data/gallery.js.
   Used on the Home page ("Moments from Our Work"). */
import { gallery, galleryCategories } from "../data/gallery.js";
import Media from "./Media.astro";
import Icon from "./Icon.astro";
interface Props { limit?: number; filters?: boolean; layout?: "grid" | "masonry"; id?: string }
const { limit = gallery.length, filters = false, layout = "masonry", id = "gallery-grid" } = Astro.props;
// Show only real photos once any exist; placeholders appear only for an empty gallery.
const real = gallery.filter((g) => g.src);
// Grid layout with fewer photos than slots: show five as one large (2 × 2) + four small.
const featureFirst = layout === "grid" && real.length > 0 && real.length < limit;
const items = (real.length ? real : gallery).slice(0, featureFirst ? 5 : limit);
const categories = galleryCategories.filter((c) => items.some((g) => g.category === c));

const ratios = ["4 / 3", "3 / 4", "1 / 1", "4 / 5", "3 / 2", "1 / 1"];
---
<div data-gallery>
  {filters && (
    <div class="js-only mb-8 flex flex-wrap gap-2.5" role="group" aria-label="Filter gallery by category">
      <button type="button" class="filter-chip" aria-pressed="true" data-filter="all">All</button>
      {categories.map((c) => <button type="button" class="filter-chip" aria-pressed="false" data-filter={c}>{c}</button>)}
    </div>
  )}
  <p class="sr-only" aria-live="polite" data-gallery-status></p>
  <ul id={id} class:list={[layout === "masonry" ? "masonry" : "grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5"]}>
    {items.map((img, i) => (
      <li class:list={["gallery-item reveal", featureFirst && i === 0 && "col-span-2 md:row-span-2"]} data-category={img.category}>
        <figure>
          <button
            type="button"
            class="group block w-full cursor-zoom-in rounded-3xl text-left transition hover:opacity-95"
            data-lightbox-index={i}
            data-caption={img.caption}
            aria-label={`Open larger view: ${img.alt}`}
          >
            <Media
              src={img.src}
              alt={img.alt}
              label={`Gallery image ${String(i + 1).padStart(2, "0")}`}
              size="1200 px long side"
              ratio={layout === "masonry" ? (img.width ? `${img.width} / ${img.height}` : ratios[i % ratios.length]) : "1 / 1"}
              width={img.width}
              height={img.height}
              class="pointer-events-none transition duration-300 group-hover:shadow-[var(--shadow-lift)]"
              sizes={layout === "masonry" ? "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" : (featureFirst && i === 0 ? "(min-width: 768px) 50vw, 100vw" : "(min-width: 768px) 25vw, 50vw")}
            />
          </button>
          {img.caption && layout === "masonry" && <figcaption class="mt-2.5 px-1 text-sm font-semibold text-ink-soft">{img.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label="Image viewer" data-lightbox>
    <div class="flex items-center justify-between gap-4 px-5 py-3 sm:px-7">
      <p class="font-bold" data-lightbox-counter></p>
      <button type="button" class="inline-flex size-12 items-center justify-center rounded-full border-2 border-blue bg-white" data-lightbox-close>
        <Icon name="close" size={24} /><span class="sr-only">Close image viewer</span>
      </button>
    </div>
    <figure class="px-5 pb-5 sm:px-7 sm:pb-7">
      <div class="mx-auto max-h-[65dvh] overflow-hidden [&_.ph]:max-h-[65dvh] [&_.media]:max-h-[65dvh] [&_img]:max-h-[65dvh] [&_img]:object-contain" data-lightbox-stage></div>
      <div class="mt-4 flex items-center justify-between gap-4">
        <button type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-blue-tint" data-lightbox-prev>
          <Icon name="chevronLeft" size={24} /><span class="sr-only">Previous image</span>
        </button>
        <figcaption class="text-center font-semibold" data-lightbox-caption></figcaption>
        <button type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-blue-tint" data-lightbox-next>
          <Icon name="chevronRight" size={24} /><span class="sr-only">Next image</span>
        </button>
      </div>
    </figure>
  </dialog>
</div>
