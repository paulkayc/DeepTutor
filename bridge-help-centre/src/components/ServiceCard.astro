---
/* One service box on the Home page: icon marker, service name (links to its
   section on Our Programmes), short description and WhatsApp + email icon buttons. */
import Icon from "./Icon.astro";
import { whatsappLink, emailLink } from "../config/site.js";
interface Props { service: { id: string; name: string; summary: string; icon: string } }
const { service } = Astro.props;
---
<article class="card card-hover reveal flex h-full flex-col !p-7">
  <div class="flex items-start gap-4">
    <span class="icon-badge !size-12 !rounded-full !bg-magenta !text-white [&_svg]:!text-white"><Icon name={service.icon} size={24} /></span>
    <h3 class="pt-1.5 text-xl font-bold leading-snug">
      <a href={`/programmes#${service.id}`} class="hover:text-magenta-deep hover:underline hover:decoration-2 hover:underline-offset-4">{service.name}</a>
    </h3>
  </div>
  <p class="mt-4 text-ink-soft">{service.summary}</p>
  <div class="mt-auto flex gap-3 pt-6">
    <a
      href={whatsappLink(`Hello, I would like to enquire about ${service.name}`)}
      target="_blank"
      rel="noopener"
      class="inline-flex size-11 items-center justify-center rounded-full bg-magenta text-white transition hover:-translate-y-0.5 hover:bg-magenta-deep"
      aria-label={`WhatsApp us about ${service.name} (opens in a new tab)`}
      title="Chat on WhatsApp"
    >
      <Icon name="whatsapp" size={22} />
    </a>
    <a
      href={emailLink(`Enquiry: ${service.name}`)}
      class="inline-flex size-11 items-center justify-center rounded-full bg-blue text-ink transition hover:-translate-y-0.5"
      aria-label={`Email us about ${service.name}`}
      title="Send an email"
    >
      <Icon name="mail" size={22} />
    </a>
  </div>
</article>
