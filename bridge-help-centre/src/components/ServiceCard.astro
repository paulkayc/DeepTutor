---
import Icon from "./Icon.astro";
interface Props { service: { id: string; name: string; summary: string; icon: string } }
const { service } = Astro.props;
---
<a href={`/programmes#${service.id}`} class="card card-hover reveal group flex h-full flex-col">
  <span class="icon-badge"><Icon name={service.icon} size={28} /></span>
  <h3 class="h-sub mt-6">{service.name}</h3>
  <p class="mt-3 text-ink-soft">{service.summary}</p>
  <span class="link-arrow mt-auto pt-5" aria-hidden="true">Learn more <Icon name="arrow" size={20} /></span>
</a>
