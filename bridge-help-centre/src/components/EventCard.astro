---
import { whatsappLink } from "../config/site.js";
import Media from "./Media.astro";
import Icon from "./Icon.astro";
interface Props { event: { title: string; date: string; location?: string; description: string; image?: string }; layout?: "card" | "row"; headingLevel?: 3 | 4 }
const { event, layout = "card" } = Astro.props;
const d = new Date(event.date + "T12:00:00");
const day = d.toLocaleDateString("en-GB", { day: "numeric" });
const month = d.toLocaleDateString("en-GB", { month: "short" });
const full = d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const register = whatsappLink(`Hello, I would like to register interest in ${event.title}`);
---
<article class:list={["card card-hover reveal flex !p-0 overflow-hidden", layout === "row" ? "flex-col md:flex-row" : "flex-col"]} data-event-date={event.date}>
  <div class:list={["relative", layout === "row" && "md:w-[42%] md:shrink-0"]}>
    <Media src={event.image} alt={`Photo for ${event.title}`} label="Programme photo" size="1200 × 800 px" ratio="3 / 2" class="!rounded-none !border-x-0 !border-t-0" width={1200} height={800} />
    <p class="date-badge absolute left-4 top-4" aria-hidden="true"><span class="text-2xl">{day}</span><span class="mt-1 text-xs uppercase tracking-wider">{month}</span></p>
  </div>
  <div class="flex flex-1 flex-col p-7">
    <p class="text-sm font-bold text-magenta-deep"><time datetime={event.date}>{full}</time></p>
    <h3 class="h-sub mt-2"><span class="placeholder-aware">{event.title}</span></h3>
    {event.location && layout === "row" && <p class="mt-2 flex items-center gap-2 text-ink-soft"><Icon name="pin" size={18} />{event.location}</p>}
    <p class="mt-3 text-ink-soft">{event.description}</p>
    <div class="mt-auto pt-6">
      {layout === "row" ? (
        <a href={register} target="_blank" rel="noopener" class="btn btn-primary btn-sm"><Icon name="whatsapp" size={20} />Register Interest<span class="sr-only"> in {event.title} on WhatsApp</span></a>
      ) : (
        <a href={register} target="_blank" rel="noopener" class="link-arrow">Register Interest<span class="sr-only"> in {event.title} on WhatsApp</span><Icon name="arrow" size={20} /></a>
      )}
    </div>
  </div>
</article>
