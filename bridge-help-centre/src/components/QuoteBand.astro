---
/* Client quote (editor: "Home page text" → Quote). Hidden when the quote box is empty. */
import { homeText } from "../data/text.js";
const { text, author } = homeText.quote;
---
{text && (
<section class="section bg-white" aria-label="Our promise">
  <figure class="container-site reveal mx-auto max-w-5xl text-center">
    <span aria-hidden="true" class="block h-16 font-serif text-[8rem] leading-none text-magenta lg:h-20 lg:text-[10rem]">“</span>
    <blockquote class="mt-4 text-[1.75rem] font-medium leading-snug tracking-[-0.01em] lg:text-4xl">
      <p>{text}<span aria-hidden="true" class="text-magenta">”</span></p>
    </blockquote>
    {author && <figcaption class="mt-8 text-lg font-bold">— {author}</figcaption>}
  </figure>
</section>
)}
