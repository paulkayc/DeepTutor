---
/* Featured upcoming programme on the Home page: a gentle crossfading
   slideshow of its images (pause button + dots; stays still for visitors who
   prefer reduced motion) beside the event details as real text. */
import Icon from "./Icon.astro";
import { whatsappLink } from "../config/site.js";
import { srcsetFor } from "../lib/images.js";
interface Slide { src: string; alt: string }
interface Props {
  event: {
    title: string; subtitle?: string; date: string; time?: string; location?: string;
    price?: string; speaker?: string; slides: Slide[]; speakerBio?: string[];
    registerForm?: string; registerFormEmbed?: string;
  };
}
const { event } = Astro.props;
const when = new Date(event.date + "T12:00:00").toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const details = [
  { icon: "calendar", label: "Date", value: when },
  event.time && { icon: "clock", label: "Time", value: event.time },
  event.location && { icon: "pin", label: "Where", value: event.location },
  event.price && { icon: "check", label: "Registration", value: event.price },
  event.speaker && { icon: "user", label: "Speaker", value: event.speaker },
].filter(Boolean) as { icon: string; label: string; value: string }[];
---
<div class="grid items-start gap-10 lg:grid-cols-[5fr_6fr] lg:gap-16" data-event-date={event.date}>
  <div class="slideshow mx-auto w-full max-w-md lg:max-w-none" data-slideshow aria-roledescription="carousel" aria-label={`${event.title}: flyer and speaker profile`}>
    <div class="relative aspect-[4/5] overflow-hidden rounded-3xl bg-blue-tint shadow-[var(--shadow-soft)]" aria-live="off" data-slideshow-track>
      {event.slides.map((s, i) => (
        <figure class:list={["slide", i === 0 && "is-active"]} data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${event.slides.length}`}>
          <a href={s.src} target="_blank" rel="noopener" class="block h-full" title="Open full size">
            <img src={s.src} srcset={srcsetFor(s.src)} sizes="(min-width: 1024px) 40vw, (min-width: 448px) 28rem, 100vw" alt={s.alt} width="864" height="1080" loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </a>
        </figure>
      ))}
    </div>
    {event.slides.length > 1 && (
      <div class="js-only mt-4 flex items-center justify-center gap-3">
        <button type="button" class="inline-flex size-11 items-center justify-center rounded-full border-2 border-blue bg-white" data-slideshow-toggle aria-label="Pause slideshow">
          <span class="inline-flex" data-icon-pause><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></span>
          <span class="inline-flex" data-icon-play hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10-6.5a1 1 0 0 0 0-1.72l-10-6.5A1 1 0 0 0 8 5.5Z"/></svg></span>
        </button>
        {event.slides.map((_, i) => (
          <button type="button" class="slide-dot" data-slide-dot={i} aria-label={`Show image ${i + 1} of ${event.slides.length}`} aria-current={i === 0 ? "true" : undefined}>
            <span aria-hidden="true"></span>
          </button>
        ))}
      </div>
    )}
    <p class="mt-3 text-center text-sm text-ink-soft">Tap an image to see it full size.</p>
  </div>

  <div>
    <h3 class="text-[1.75rem] font-extrabold leading-tight tracking-[-0.01em] lg:text-4xl">{event.title}</h3>
    {event.subtitle && <p class="hero-copy mt-3 text-lg text-ink-soft lg:text-xl">{event.subtitle}</p>}
    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      {details.map((d) => (
        <div class="grid grid-cols-[auto_1fr] items-start gap-x-3">
          <dt class="contents">
            <span class="icon-badge row-span-2 !size-11 !rounded-full"><Icon name={d.icon} size={20} /></span>
            <span class="text-sm font-bold uppercase tracking-wider text-ink-soft">{d.label}</span>
          </dt>
          <dd class="col-start-2 font-semibold">{d.value}</dd>
        </div>
      ))}
    </dl>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      {(event.registerFormEmbed || event.registerForm) && (
        <a href="#register-form" class="btn btn-primary" data-open-register><Icon name="file" size={22} />Register with our form</a>
      )}
      <a href={whatsappLink(`Hello, I would like to register for ${event.title} on ${when}`)} target="_blank" rel="noopener" class:list={["btn", (event.registerFormEmbed || event.registerForm) ? "btn-secondary" : "btn-primary"]}><Icon name="whatsapp" />Register on WhatsApp</a>
    </div>
    {(event.registerFormEmbed || event.registerForm) && (
      <details id="register-form" class="mt-6 scroll-mt-28 rounded-3xl border-2 border-blue bg-white" data-register-form>
        <summary class="flex min-h-14 items-center justify-between gap-4 px-6 py-4 text-lg font-bold">
          Registration form
          <Icon name="chevronDown" size={22} class="accordion-chevron shrink-0 transition-transform" />
        </summary>
        <div class="px-2 pb-4 sm:px-4">
          <p class="px-4 pb-3 text-sm text-ink-soft">
            Trouble with the form? <a href={event.registerForm || event.registerFormEmbed} target="_blank" rel="noopener" class="link">Open it in a new tab</a>. Provided by Google, which may set cookies.
          </p>
          <div class="relative overflow-hidden rounded-2xl bg-blue-tint">
            <p class="absolute inset-x-0 top-10 text-center font-semibold" aria-hidden="true">Loading the form…</p>
            <iframe src={event.registerFormEmbed || event.registerForm} title={`Registration form for ${event.title} (Google Forms)`} class="relative block h-[1100px] w-full border-0 sm:h-[950px]" loading="lazy">Loading…</iframe>
          </div>
        </div>
      </details>
    )}
    {event.speakerBio && (
      <details class="mt-10 rounded-3xl bg-blue-tint">
        <summary class="flex min-h-14 items-center justify-between gap-4 px-6 py-4 text-lg font-bold">
          About the speaker{event.speaker && `: ${event.speaker}`}
          <Icon name="chevronDown" size={22} class="accordion-chevron shrink-0 transition-transform" />
        </summary>
        <div class="hero-copy space-y-4 px-6 pb-6 text-[1.0625rem] leading-relaxed">
          {event.speakerBio.map((p) => <p>{p}</p>)}
        </div>
      </details>
    )}
  </div>
</div>
